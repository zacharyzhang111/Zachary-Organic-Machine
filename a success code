#include <Wire.h>              
#include "Adafruit_MPR121.h"   
#include <Adafruit_NeoPixel.h>  


#ifndef _BV
#define _BV(bit) (1 << (bit))
#endif

#define LEDS_PER_STRIP 10      
#define STRIP_COLOR_ORDER NEO_RGB + NEO_KHZ800 

#define STRIP_ON_COLOR  Adafruit_NeoPixel::Color(0, 0, 255)  
#define STRIP_OFF_COLOR Adafruit_NeoPixel::Color(0, 0, 0)   


Adafruit_MPR121 cap = Adafruit_MPR121();
uint16_t lasttouched = 0;  
uint16_t currtouched = 0; 


Adafruit_NeoPixel strip2 = Adafruit_NeoPixel(LEDS_PER_STRIP, 2, STRIP_COLOR_ORDER);
Adafruit_NeoPixel strip3 = Adafruit_NeoPixel(LEDS_PER_STRIP, 3, STRIP_COLOR_ORDER);
Adafruit_NeoPixel strip4 = Adafruit_NeoPixel(LEDS_PER_STRIP, 4, STRIP_COLOR_ORDER);
Adafruit_NeoPixel strip5 = Adafruit_NeoPixel(LEDS_PER_STRIP, 5, STRIP_COLOR_ORDER);
Adafruit_NeoPixel strip6 = Adafruit_NeoPixel(LEDS_PER_STRIP, 6, STRIP_COLOR_ORDER);


void setStripAll(Adafruit_NeoPixel &strip, uint32_t color) {
  for(uint8_t i=0; i<LEDS_PER_STRIP; i++) {
    strip.setPixelColor(i, color); 
  }
  strip.show(); 
}

/**
- Function       setup
- @brief         
- @param[in]     void
- @retval        void
*/
void setup() {
 
  Serial.begin(9600);
  while (!Serial) { 
    delay(10);
  }
  Serial.println("===== MPR121 Multi-Strip Control Started =====");

  // ==================== MPR121 Initialization ====================
  Serial.println("Adafruit MPR121 Capacitive Touch sensor test");
  // Default I2C address is 0x5A (configurable to 0x5B/0x5C/0x5D via hardware)
  if (!cap.begin(0x5A)) {
    Serial.println("MPR121 not found, check wiring?");
    while (1); // Halt on initialization failure
  }
  Serial.println("MPR121 found!");
  // Enable auto-configuration
  Serial.println("Running auto configuration.");
  cap.setAutoconfig(true);
  Serial.println("MPR121 Initialization complete.");

  // ==================== RGB Strips Initialization ====================
  strip2.begin();  strip2.show();  // Init strip on pin 2 (off)
  strip3.begin();  strip3.show();  // Init strip on pin 3 (off)
  strip4.begin();  strip4.show();  // Init strip on pin 4 (off)
  strip5.begin();  strip5.show();  // Init strip on pin 5 (off)
  strip6.begin();  strip6.show();  // Init strip on pin 6 (off)

  // Set global brightness (0-255) to limit current draw
  strip2.setBrightness(120);
  strip3.setBrightness(120);
  strip4.setBrightness(120);
  strip5.setBrightness(120);
  strip6.setBrightness(120);

  Serial.println("5 RGB strips initialized on pins 2/3/4/5/6");
  Serial.println("===========================================");
}

/**
- Function       loop
- @brief         Main loop: light up corresponding LED strip on touch
- @param[in]     void
- @retval        void
*/
void loop() {
  // ==================== Step 1: Read current touch state ====================
  currtouched = cap.touched();

  // ==================== Step 2: Check all 12 touch channels ====================
  for (uint8_t i=0; i<12; i++) {
    // -------------------- Trigger on touch press --------------------
    if ((currtouched & _BV(i)) && !(lasttouched & _BV(i)) ) {
      Serial.print(i); Serial.println(" touched");

      // Light up all 10 LEDs on the strip matching channel i
      switch(i) {
        case 2:
          setStripAll(strip2, STRIP_ON_COLOR);
          Serial.println("Pin 2 strip ON");
          break;
        case 3:
          setStripAll(strip3, STRIP_ON_COLOR);
          Serial.println("Pin 3 strip ON");
          break;
        case 4:
          setStripAll(strip4, STRIP_ON_COLOR);
          Serial.println("Pin 4 strip ON");
          break;
        case 5:
          setStripAll(strip5, STRIP_ON_COLOR);
          Serial.println("Pin 5 strip ON");
          break;
        case 6:
          setStripAll(strip6, STRIP_ON_COLOR);
          Serial.println("Pin 6 strip ON");
          break;
        default:
          // Channels 0, 1, and 7-11 have no mapped strips; log only
          break;
      }
    }

    // -------------------- Trigger on touch release --------------------
    if (!(currtouched & _BV(i)) && (lasttouched & _BV(i)) ) {
      Serial.print(i); Serial.println(" released");

      // Turn off corresponding strip on release (comment out block if not needed)
      switch(i) {
        case 2:
          setStripAll(strip2, STRIP_OFF_COLOR);
          Serial.println("Pin 2 strip OFF");
          break;
        case 3:
          setStripAll(strip3, STRIP_OFF_COLOR);
          Serial.println("Pin 3 strip OFF");
          break;
        case 4:
          setStripAll(strip4, STRIP_OFF_COLOR);
          Serial.println("Pin 4 strip OFF");
          break;
        case 5:
          setStripAll(strip5, STRIP_OFF_COLOR);
          Serial.println("Pin 5 strip OFF");
          break;
        case 6:
          setStripAll(strip6, STRIP_OFF_COLOR);
          Serial.println("Pin 6 strip OFF");
          break;
        default:
          break;
      }
    }
  }

  // ==================== Step 3: Update last touch state ====================
  lasttouched = currtouched;

  // ==================== MPR121 Raw Debug Output (Disabled by default) ====================
  // Comment out 'return;' below to enable serial debug output
  return;

  // Debug info: hex touch state, filtered data, and baseline data
  Serial.print("\t\t\t\t\t\t\t\t\t\t\t\t\t 0x"); Serial.println(cap.touched(), HEX);
  Serial.print("Filt: ");
  for (uint8_t i=0; i<12; i++) {
    Serial.print(cap.filteredData(i)); Serial.print("\t");
  }
  Serial.println();
  Serial.print("Base: ");
  for (uint8_t i=0; i<12; i++) {
    Serial.print(cap.baselineData(i)); Serial.print("\t");
  }
