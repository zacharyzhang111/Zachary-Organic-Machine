#include <Wire.h>
#include <Adafruit_MPR121.h>

Adafruit_MPR121 cap = Adafruit_MPR121();

void setup() {
  Serial.begin(9600);
  while(!Serial){;}

  if (!cap.begin(0x5A)) {   // Use detected I2C address 0x5A
    Serial.println("MPR121 initialization failed");
    while (1);
  }

  Serial.println("Initialized. Waiting 1s for baseline stabilization...");
  delay(1000);

  cap.setThresholds(10, 5); // Set sensitivity (lower values = more sensitive)
  Serial.println("Monitoring started. Watch E0 data changes:");
}

void loop() {
  uint16_t f0 = cap.filteredData(0);   // Filtered raw data
  uint16_t b0 = cap.baselineData(0);   // Auto-baseline data
  int16_t delta0 = (int16_t)b0 - (int16_t)f0;

  Serial.print("E0: filtered=");
  Serial.print(f0);
  Serial.print(" baseline=");
  Serial.print(b0);
  Serial.print(" delta=");
  Serial.println(delta0);

  delay(200); // Print every 200ms
}
